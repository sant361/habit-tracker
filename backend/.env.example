PORT=3000
JWT_SECRET=cambia-este-secreto
CORS_ORIGIN=http://localhost:5173
DB_FILE=habit-tracker.db

# Opcional: si defines DATABASE_URL se usa PostgreSQL en vez del archivo SQLite (DB_FILE).
# Así los datos no se pierden al publicar. Ejemplo:
# DATABASE_URL=postgresql://usuario:clave@host/basededatos
# DATABASE_SSL=false   # solo si tu Postgres local no usa SSL
