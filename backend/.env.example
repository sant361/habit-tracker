PORT=3000
JWT_SECRET=cambia-este-secreto
CORS_ORIGIN=http://localhost:5173
DB_FILE=habit-tracker.db

# Opcional: si defines DATABASE_URL se usa PostgreSQL en vez del archivo SQLite (DB_FILE).
# Así los datos no se pierden al publicar. Ejemplo:
# DATABASE_URL=postgresql://usuario:clave@host/basededatos
# DATABASE_SSL=false   # solo si tu Postgres local no usa SSL

# Correo(s) de administrador, separados por comas. Debe ser una cuenta que ya hayas registrado tú.
# Sin esta variable no hay administradores.
# ADMIN_EMAIL=tucorreo@gmail.com

# Opcional: recuperar la clave por correo con Gmail (contraseña de aplicación, no la clave normal).
# GMAIL_USER=tucorreo@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# APP_URL=http://localhost:5173
